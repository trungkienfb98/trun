# Sao chép file này thành .env rồi điền thông tin. KHÔNG đưa file .env lên GitHub.

# ===== AI (bắt buộc) =====
ANTHROPIC_API_KEY=sk-ant-...
BOT_MODEL=claude-opus-5-5
# low = nhanh, rẻ, đủ cho chat bán hàng; medium/high = suy nghĩ kỹ hơn
BOT_EFFORT=low
# Hồ sơ shop: sản phẩm, giá, chính sách (sửa file shop.md)
SHOP_FILE=shop.md

# ===== Facebook Page =====
FB_PAGE_ID=
FB_PAGE_TOKEN=
FB_APP_SECRET=
# Tự đặt một chuỗi bất kỳ, rồi nhập đúng chuỗi đó khi cài webhook trên Meta
FB_VERIFY_TOKEN=doi-chuoi-nay-di
# 1 = tự trả lời bình luận trên bài của Page (nhắn riêng + trả lời công khai)
FB_REPLY_COMMENTS=1
FB_COMMENT_REPLY_TEXT=Dạ shop đã nhắn tin tư vấn chi tiết cho mình rồi ạ, mình check inbox giúp shop nhé ❤️

# ===== Zalo OA =====
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OA_SECRET=
ZALO_ACCESS_TOKEN=
ZALO_REFRESH_TOKEN=

# ===== Vận hành =====
# Sau khi chuyển cho nhân viên (hoặc nhân viên tự nhắn), bot im lặng với khách đó bao nhiêu giờ
HANDOFF_HOURS=12
# Webhook nhận đơn mới / yêu cầu gặp nhân viên (Google Apps Script, n8n, Make...). Để trống nếu không dùng.
ORDER_WEBHOOK_URL=
# Mật khẩu để xem /don-hang
ADMIN_KEY=
